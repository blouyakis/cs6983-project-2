# Supabase project URL. The app does not read this until the database is connected (#3).
SUPABASE_URL=

# Server-only database key. Never send this to the browser. Unused until #3.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only signing key for session tokens. Use at least 32 random characters.
JWT_SECRET=

# Base URL of the app, for example http://localhost:3000. Unused until a feature needs it.
NEXT_PUBLIC_APP_URL=
