# Supabase project URL, read by src/lib/db. Locally, `npx supabase status` prints it as API_URL.
SUPABASE_URL=

# Server-only database key, read by src/lib/db. Never send this to the browser. Locally, `npx supabase status`
# prints it as SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only signing key for session tokens. Use at least 32 random characters. Unused until #4.
JWT_SECRET=

# Base URL of the app, for example http://localhost:3000. Unused until a feature needs it.
NEXT_PUBLIC_APP_URL=
